# OMF Atlas nginx vhost. Serves the static Vite build in /var/www/omfatlas/dist.
#
# deploy/deploy.sh copies this file to the server's home directory on every run,
# so ~/omfatlas.xera.ac.nginx is always a fresh copy of this file.
#
# First install (needs root):
#   sudo cp ~/omfatlas.xera.ac.nginx /etc/nginx/sites-available/omfatlas.xera.ac
#   sudo ln -sfn /etc/nginx/sites-available/omfatlas.xera.ac /etc/nginx/sites-enabled/omfatlas.xera.ac
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d omfatlas.xera.ac --agree-tos -m ahmad.pub@gmail.com --redirect
#
# AFTER certbot has run, do NOT copy this file over the installed one again:
# certbot rewrote that file in place to add the TLS block, and this copy is
# still HTTP only, so overwriting it would take the certificate configuration
# with it. To change the headers, edit deploy/omfatlas-headers.conf and run:
#   sudo ~/omfatlas-install-csp.sh
# which inserts them into the block certbot produced and rolls back if nginx
# rejects the result.
#
# This file is HTTP-only on purpose. certbot --nginx rewrites it in place, adding
# the listen 443 block, the certificate paths, and the 80 to 443 redirect, exactly
# as it did for the sibling sites on this box.

# IPv4 only, exactly like every sibling vhost on this box. This is deliberate.
# omfatlas.xera.ac is an A record, and no other vhost here binds [::]:80. If this
# file were the only one to bind it, nginx would make this server block the
# DEFAULT for IPv6 port 80, and an IPv6 request for any OTHER xera.ac site would
# land on this site. Matching the siblings avoids that entirely.
server {
    listen 80;
    server_name omfatlas.xera.ac;

    root /var/www/omfatlas/dist;
    index index.html;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # This site loads Google Analytics, and the box-wide policy in
    # /etc/nginx/conf.d/security.conf names neither googletagmanager.com nor
    # google-analytics.com, so gtag.js would be blocked with nothing in the
    # response to say why. The policy is restated here with those two hosts
    # added.
    #
    # nginx does not merge add_header directives across levels: a block that
    # declares one drops every header it would otherwise inherit. So the four
    # other security headers from that file are repeated here as well, or
    # setting the policy would quietly remove them.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # The atlas is one page with no router, so there is no deep link to fall
    # back for. Serving the shell at every unknown path instead made each
    # typo, each stale link, and each probe a 200 OK copy of the homepage,
    # which is what a search engine reads as a soft 404. It also swallowed
    # /robots.txt, /sitemap.xml, and /favicon.ico before those files existed,
    # answering each of them with HTML. Unknown paths are now 404.
    location / {
        try_files $uri $uri/ =404;
    }

    # Vite content-hashes these filenames, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, immutable, max-age=31536000";
    }

    # Anatomy binaries are NOT content-hashed: a new build reuses the same
    # names. One day of caching, never immutable, or a geometry update would
    # strand returning visitors on stale meshes.
    #
    # deploy.sh writes a .gz next to every .bin and .json, and gzip_static
    # serves it directly. omf.bin alone drops from 17.8 MB to 10.0 MB with
    # no per-request compression cost.
    location /models/ {
        gzip_static on;
        add_header Cache-Control "public, max-age=86400";
        types { application/octet-stream bin; application/json json; }
        default_type application/octet-stream;
    }
}
